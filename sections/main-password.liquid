<section class="password-page">
  <div class="password-card">
    <a href="/" class="password-logo">{{ section.settings.logo_text | escape }}</a>

    <span class="password-divider"></span>

    <p class="password-eyebrow">{{ section.settings.eyebrow | escape }}</p>

    <h1>
      {{ section.settings.heading_start | escape -}}
      <br>
      {{ section.settings.heading_middle | escape }}
      <em>{{ section.settings.heading_emphasis | escape }}</em>
    </h1>

    <p class="password-description">{{ section.settings.description | escape }}</p>

    {% form 'storefront_password', class: 'password-form' %}
      {%- if form.errors -%}
        <div class="password-error">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <label for="store-password">{{ section.settings.input_label | escape }}</label>

      <input
        type="password"
        id="store-password"
        name="password"
        placeholder="{{ section.settings.input_placeholder | escape }}"
        required
      >

      <button type="submit">
        {{ section.settings.button_label | escape }}
        <span>→</span>
      </button>
    {% endform %}

    <p class="password-footer">{{ section.settings.footer_text | escape }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "BREW & BEAN" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "A LITTLE SOMETHING BREWING" },
    { "type": "text", "id": "heading_start", "label": "Heading line 1", "default": "We're preparing" },
    { "type": "text", "id": "heading_middle", "label": "Heading line 2", "default": "something" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading italic word", "default": "special." },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our coffee corner is getting ready. Enter the password to step inside."
    },
    { "type": "text", "id": "input_label", "label": "Input label", "default": "Store password" },
    { "type": "text", "id": "input_placeholder", "label": "Input placeholder", "default": "Enter your password" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Enter Store" },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Thank you for your patience. Fresh coffee awaits."
    }
  ]
}
{% endschema %}
