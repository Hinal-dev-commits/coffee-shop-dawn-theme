{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}

{%- render 'cart-drawer',
  label: section.settings.label,
  heading: section.settings.heading,
  note: section.settings.note
-%}

<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "YOUR SELECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Cart"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Shipping note",
      "default": "Shipping and applicable taxes calculated at checkout."
    }
  ]
}
{% endschema %}
