<section class="liquid-practice page-width">
  <h2>Liquid practice: discounts</h2>

  <h3>1. Cart-level discounts</h3>
  {%- for app in cart.cart_level_discount_applications -%}
    <p>
      Title: {{ app.title -}}
      <br>
      Type: {{ app.type -}}
      <br>
      Value type: {{ app.value_type -}}
      <br>
      Value: {{ app.value -}}
      <br>
      Saved: {{ app.total_allocated_amount | money }}
    </p>
  {%- else -%}
    <p>No cart-level discount applied.</p>
  {%- endfor -%}

  <h3>2. Line-level discounts (per item)</h3>
  {%- for item in cart.items -%}
    {%- for alloc in item.line_level_discount_allocations -%}
      <p>{{ item.product.title }}: {{ alloc.discount_application.title }} → {{ alloc.amount | money }}</p>
    {%- endfor -%}
  {%- endfor -%}

  <h3>3. Totals</h3>
  <p>Original total: {{ cart.original_total_price | money }}</p>
  <p>Total discount: {{ cart.total_discount | money }}</p>
  <p>Final total: {{ cart.total_price | money }}</p>

  <h3>4. Raw data (to see every field)</h3>
  <pre>{{ cart.cart_level_discount_applications | json }}</pre>
</section>

{% schema %}
{
  "name": "Liquid practice",
  "settings": [],
  "presets": [{ "name": "Liquid practice" }]
}
{% endschema %}
