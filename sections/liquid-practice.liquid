<section class="liquid-practice page-width">
  <h2>Liquid practice: form</h2>

  <h3>1. Contact form</h3>

  {%- form 'contact', id: 'PracticeForm', novalidate: 'novalidate' -%}

    {%- if form.posted_successfully? -%}
      <p style="color: green;"><strong>posted_successfully? = true</strong>. Message sent!</p>
    {%- endif -%}

    {%- if form.errors -%}
      <div style="color: red;" role="alert">
        <strong>form.errors exists:</strong>
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <p>
      <label for="PracticeForm-name">Name</label><br>
      <input type="text" id="PracticeForm-name" name="contact[name]" value="{{ form.name }}">
    </p>

    <p>
      <label for="PracticeForm-email">Email</label><br>
      <input type="email" id="PracticeForm-email" name="contact[email]" value="{{ form.email }}">
    </p>

    <p>
      <label for="PracticeForm-body">Message</label><br>
      <textarea id="PracticeForm-body" name="contact[body]" rows="4">{{ form.body }}</textarea>
    </p>

    <button type="submit">Send</button>

    <h3>2. Raw form object</h3>
    <pre>{{ form | json }}</pre>

  {%- endform -%}

  <h3>3. Outside the form tag</h3>
  <pre>form outside the tag = {{ form | json }}</pre>
</section>

{% schema %}
{
  "name": "Liquid practice",
  "settings": [],
  "presets": [{ "name": "Liquid practice" }]
}
{% endschema %}