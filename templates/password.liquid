{% layout 'password' %}
<section class="password-page">
  <div class="password-card">
    <a href="/" class="password-logo">BREW &amp; BEAN</a>

    <span class="password-divider"></span>

    <p class="password-eyebrow">A LITTLE SOMETHING BREWING</p>

    <h1>
      We're preparing<br>
      something <em>special.</em>
    </h1>

    <p class="password-description">Our coffee corner is getting ready. Enter the password to step inside.</p>

    {% form 'storefront_password', class: 'password-form' %}
      {%- if form.errors -%}
        <div class="password-error">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <label for="store-password">Store password</label>

      <input
        type="password"
        id="store-password"
        name="password"
        placeholder="Enter your password"
        required
      >

      <button type="submit">Enter Store <span>→</span></button>





      <p class="password-footer">Thank you for your patience. Fresh coffee awaits.</p>

      </div>



      </section>



    {% endform %}
