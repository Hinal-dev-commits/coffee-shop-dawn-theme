<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
{{ 'product.css' | asset_url | stylesheet_tag }}

{%- comment -%} Read the Origin metaobject linked to this product {%- endcomment -%}
{%- assign origin = product.metafields.custom.origin.value -%}
{%- assign tasting_notes = product.metafields.custom.tasting_notes.value -%}
{%- assign roast_level = product.metafields.custom.roast_level.value -%}
{%- assign brew_methods = product.metafields.custom.brew_methods.value -%}
{%- assign pairs_with = product.metafields.custom.pairs_well_with.value -%}

<main class="product-page">
  <!-- LEFT: IMAGE GALLERY -->

  {% comment %}
    <section class="gallery">
      <div class="thumbnails">
        {%- for media in product.media -%}
          <img
            class="active"
            src="{{ media.preview_image | image_url: width: 200 }}"
            alt="Coffee beans"
          >
        {%- endfor -%}
      </div>

      <img
        id="main-image"
        class="main-image"
        src="{{ product.featured_image | image_url: width: 500 }}"
        alt="House Blend coffee"
      >
    </section>
  {% endcomment %}

  <section class="gallery" id="gallery-{{ product.id }}">
    <div class="swiper thumbs-swiper">
      <div class="swiper-wrapper">
        {%- for media in product.media -%}
          {%- assign media_alt = media.alt | default: product.title | escape -%}
          <!-- Added data-media-id here -->
          <div class="swiper-slide" data-media-id="{{ media.id }}">
            <img src="{{ media.preview_image | image_url: width: 200 }}" alt="{{ media_alt }}" loading="lazy">
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="swiper main-swiper">
      <div class="swiper-wrapper">
        {%- for media in product.media -%}
          {%- assign media_alt = media.alt | default: product.title | escape -%}
          <!-- Added data-media-id here -->
          <div class="swiper-slide" data-media-id="{{ media.id }}">
            <img src="{{ media.preview_image | image_url: width: 800 }}" alt="{{ media_alt }}" loading="lazy">
          </div>
        {%- endfor -%}
      </div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </section>
  <!-- RIGHT: PRODUCT DETAILS -->
  <section class="product-info">
    <p class="category">SPECIALTY COFFEE</p>

    <h1>{{ product.title }}</h1>

    {%- if roast_level != blank -%}
      <span class="roast-badge">{{ roast_level }} Roast</span>
    {%- endif -%}

    {%- comment -%} TASTING NOTE CHIPS: only show if this product has notes linked {%- endcomment -%}
    {%- if tasting_notes != blank -%}
      <ul class="note-chips">
        {%- for note in tasting_notes -%}
          <li class="note-chips__chip">{{ note.name }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <p class="price">{{ product.price | money_with_currency }}</p>

    <div class="rating">★★★★★ <span>4.8 (124 reviews)</span></div>

    <p class="description">
      {{ product.description }}
    </p>

    {% comment %}
      <div class="grind-options">
        <button class="selected" onclick="selectGrind(this)">Whole Bean</button>
        <button onclick="selectGrind(this)">Ground</button>
        <button onclick="selectGrind(this)">French Press</button>
      </div>

      <p class="option-label">Quantity</p>

      {% form 'product', product %}
        <div class="quantity">
          {% render 'quantity' %}
        </div>
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <button class="add-to-cart">ADD TO CART</button>
      {% endform %}
    {% endcomment %}

    {% form 'product', product %}
      <!-- Dynamic Variant Selectors -->
      {%- unless product.has_only_default_variant -%}
        <div id="product-options">
          {%- for option in product.options_with_values -%}
            <p class="option-label">{{ option.name }}</p>
            <div class="variant-options" data-option-index="option{{ option.position }}">
              {%- for value in option.values -%}
                <label class="variant-radio">
                  <input
                    type="radio"
                    name="{{ option.name }}"
                    value="{{ value | escape }}"
                    {% if option.selected_value == value %}
                      checked
                    {% endif %}
                  >
                  <span class="btn-visual">{{ value }}</span>
                </label>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      <p class="option-label">Quantity</p>
      <div class="quantity">
        {% render 'quantity' %}
      </div>

      <!-- Hidden input that tells Shopify which specific variant to add to the cart -->
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

      {%- if product.available -%}
        <button type="submit" class="add-to-cart">ADD TO CART</button>
      {%- else -%}
        <button type="button" class="add-to-cart" disabled>SOLD OUT</button>
      {%- endif -%}
      <!-- Variant JSON Data for JavaScript to read -->
      <script id="product-variants-json" type="application/json">
        [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id }},
              "option1": {{ variant.option1 | json }},
              "option2": {{ variant.option2 | json }},
              "option3": {{ variant.option3 | json }},
              "price": "{{ variant.price | money }}",
              "available": {{ variant.available }},
              "featured_media_position": {{ variant.featured_media.position | default: 0 | json }},
              "featured_media_id": {{ variant.featured_media.id | default: "null" }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    {% endform %}

    <div class="benefits">
      <div>
        <strong>♧ Organic Beans</strong>
        Carefully sourced
      </div>
      <div>
        <strong>♧ Freshly Roasted</strong>
        Packed with care
      </div>
      <div>
        <strong>♧ Secure Checkout</strong>
        Shop with confidence
      </div>
    </div>

    <details class="details">
      <summary>Product Details</summary>
      <p>
        {%- if roast_level != blank -%}
          Roast: {{ roast_level -}}
          <br>
        {%- endif -%}
        {%- if tasting_notes != blank -%}
          Tasting notes:
          {% for note in tasting_notes -%}
            {{ note.name -}}
            {%- unless forloop.last %}, {% endunless %}
          {%- endfor -%}
          <br>
        {%- endif -%}
        {%- if origin != blank -%}
          Origin: {{ origin.country -}}
          {%- if origin.region != blank %}, {{ origin.region }}{% endif -%}
          <br>
        {%- else -%}
          Origin: Update with your coffee's origin<br>
        {%- endif -%}
        Weight: 340 g<br>
        Storage: Keep in a cool, dry place.
      </p>
    </details>
    {%- comment -%} ORIGIN CARD: only shows if this product has an Origin linked {%- endcomment -%}
    {%- if origin != blank -%}
      <div class="origin-card">
        {%- if origin.image.value != blank -%}
          {{
            origin.image.value
            | image_url: width: 600
            | image_tag: loading: 'lazy', alt: origin.country, class: 'origin-card__image'
          }}
        {%- endif -%}
        <div class="origin-card__content">
          <p class="origin-card__label">WHERE IT'S FROM</p>
          <h3 class="origin-card__title">
            {{ origin.country -}}
            {%- if origin.region != blank %} · {{ origin.region }}{% endif %}
          </h3>
          {%- if origin.story != blank -%}
            <p class="origin-card__story">{{ origin.story }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- comment -%} HOW TO BREW: only shows if this product has brew methods linked {%- endcomment -%}
    {%- if brew_methods != blank -%}
      <div class="brew-guide">
        <p class="brew-guide__label">HOW TO BREW</p>
        <div class="brew-guide__list">
          {%- for method in brew_methods -%}
            <div class="brew-guide__item">
              <h4 class="brew-guide__name">{{ method.name }}</h4>
              <ul class="brew-guide__specs">
                <li><span>Grind</span> {{ method.grind_size }}</li>
                <li><span>Ratio</span> {{ method.ratio }}</li>
                <li><span>Water</span> {{ method.water_temperature }}</li>
                <li><span>Time</span> {{ method.brew_time }}</li>
              </ul>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
    {%- comment -%} COMPLETE YOUR SETUP: only shows if this product has paired products {%- endcomment -%}
    {%- if pairs_with != blank -%}
      <div class="pairs-with">
        <p class="pairs-with__label">COMPLETE YOUR SETUP</p>
        <div class="pairs-with__list">
          {%- for item in pairs_with -%}
            <a class="pairs-with__item" href="{{ item.url }}">
              {%- if item.featured_image != blank -%}
                {{
                  item.featured_image
                  | image_url: width: 200
                  | image_tag: loading: 'lazy', alt: item.title, class: 'pairs-with__image'
                }}
              {%- endif -%}
              <span class="pairs-with__title">{{ item.title }}</span>
              <span class="pairs-with__price">{{ item.price | money }}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="{{ 'product.js' | asset_url }}" defer></script>
