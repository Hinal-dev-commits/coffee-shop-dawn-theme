{{ 'Trust-Banner.css' | asset_url | stylesheet_tag }}

<section class="trust-banner">
  <div class="trust-item">
    <div class="trust-icon">✦</div>
    <div>
      <h3>{{ section.settings.EthicallySourced | default: 'Ethically Sourced' }}</h3>
      <p>{{ section.settings.subtxt1 | default: 'Thoughtfully selected beans' }}</p>
    </div>
  </div>

  <div class="trust-item">
    <div class="trust-icon">☕</div>
    <div>
      <h3>{{ section.settings.FreshlyRoasted | default: 'Freshly Roasted' }}</h3>
      <p>{{ section.settings.subtxt2 | default: 'Roasted with care' }}</p>
    </div>
  </div>

  <div class="trust-item">
    <div class="trust-icon">♡</div>
    <div>
      <h3>{{ section.settings.PackedWithCare | default: 'Packed With Care' }}</h3>
      <p>{{ section.settings.subtxt3 | default: 'Freshness in every order' }}</p>
    </div>
  </div>

  <div class="trust-item">
    <div class="trust-icon">→</div>
    <div>
      <h3>{{ section.settings.FreeShipping | default: 'Free Shipping' }}</h3>
      <p>{{ section.settings.subtxt4 | default: ' On orders over $50' }}</p>
    </div>
  </div>
</section>
