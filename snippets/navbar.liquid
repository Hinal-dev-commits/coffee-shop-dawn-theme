<script src="{{ 'mobile-menu.js' | asset_url }}" defer></script>
<script src="{{ 'cart-count.js' | asset_url }}" defer></script>
{{ 'navbar.css' | asset_url | stylesheet_tag }}
{{ 'global.css' | asset_url | stylesheet_tag }}

<header class="coffee-navbar">
  <div class="navbar-container">
    <!-- 1. The Trigger (Hamburger) -->
    <button type="button" class="mobile-menu-trigger" aria-expanded="false" aria-controls="MobileMenu">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
    <!-- Logo -->
    {% comment %}
      <a href="/" class="coffee-logo">
        {%- if settings.logo == blank -%}
          <span class="logo-icon">✳</span>
          <span class="logo-text">{{ shop.name }}</span>
        {% else %}
          <img src="{{ settings.logo | image_url: width: 120 }}" alt="{{ shop.name }}">
        {%- endif -%}
      </a>
    {% endcomment %}

    {%- assign site_logo = settings.logo | default: brand.logo -%}
    <a href="{{ routes.root_url }}" class="coffee-logo">
      {%- assign site_logo = settings.logo | default: brand.logo -%}
      {%- if site_logo != blank -%}
        <img src="{{ site_logo | image_url: width: 300 }}" alt="{{ shop.name | escape }}" width="150" loading="eager">
      {%- else -%}
        <span class="logo-icon">✳</span>
        <span class="logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <!-- Navigation menus -->
    <nav class="navbar-menu desktop-only" aria-label="Main navigation">
      {%- assign navbar_menu = settings.header_nav -%}

      {%- if navbar_menu != blank -%}
        {%- for link in navbar_menu.links -%}
          <div class="menu-item">
            <a class="nav-link{% if link.active %} active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </nav>

    <!-- Cart icon -->
    <div>
      <button
        type="button"
        class="navbar-search search-btn navbar-cart"
        aria-label="Open search"
        data-search-open
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
        </svg>
      </button>
      <a href="/cart" class="navbar-cart" aria-label="Shopping cart" data-cart-open>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 8H6"/>
          <circle cx="10" cy="21" r="1"/>
          <circle cx="19" cy="21" r="1"/>
        </svg>
        <span
          class="cart-badge"
          data-cart-count
          {% if cart.item_count == 0 %}
            hidden
          {% endif %}
        >
          {{- cart.item_count -}}
        </span>
      </a>
    </div>
  </div>

  <!-- 2. The Drawer Structure (Mobile) -->
  <div id="MobileMenu" class="mobile-drawer" aria-hidden="true">
    <div class="drawer-header">
      <button type="button" class="drawer-close" aria-label="Close menu">✕</button>
    </div>
    <nav class="drawer-nav">
      {%- for link in linklists['main-menu'].links -%}
        <a class="drawer-link{% if link.active %} active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  </div>
  <div class="search-panel" data-search-panel>
    <div class="search-panel-inner">
      <div class="search-panel-header">
        <span>Search</span>

        <button
          type="button"
          class="search-close"
          aria-label="Close search"
          data-search-close
        >
          ×
        </button>
      </div>

      <form
        action="{{ routes.search_url }}"
        method="get"
        class="search-form"
      >
        <div class="search-input-wrapper">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>

          <input
            type="search"
            name="q"
            placeholder="Search coffee, beans, accessories..."
            autocomplete="off"
            data-search-input
          >
        </div>
      </form>
    </div>
  </div>

  <!-- Overlay to darken the background when open -->
  <div class="drawer-overlay"></div>
</header>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    const searchPanel = document.querySelector('[data-search-panel]');
    const searchOpen = document.querySelector('[data-search-open]');
    const searchClose = document.querySelector('[data-search-close]');
    const searchInput = document.querySelector('[data-search-input]');

    if (!searchPanel || !searchOpen) return;

    searchOpen.addEventListener('click', function () {
      searchPanel.classList.add('is-open');

      setTimeout(() => {
        searchInput?.focus();
      }, 200);
    });

    searchClose?.addEventListener('click', function () {
      searchPanel.classList.remove('is-open');
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        searchPanel.classList.remove('is-open');
      }
    });
  });
{% endjavascript %}
