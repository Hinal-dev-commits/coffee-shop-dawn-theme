{{ 'navbar.css' | asset_url | stylesheet_tag }}

<header class="coffee-navbar">
  <div class="navbar-container">
    <!-- Logo -->
    <a href="/" class="coffee-logo">
      {%- if settings.logo == blank -%}
        <span class="logo-icon">✳</span>
        <span class="logo-text">{{ shop.name }}</span>
      {% else %}
        <img src="{{ settings.logo | image_url: width: 120 }}" alt="{{ shop.name }}">
      {%- endif -%}
    </a>

    <!-- Navigation menus -->
    <nav class="navbar-menu" aria-label="Main navigation">
      {%- for link in settings.header_nav.links -%}
        <a class="nav-link{% if link.active %} active{% endif %}" href="{{ link.url }}"> {{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <!-- Cart icon -->
    <a href="/cart" class="navbar-cart" aria-label="Shopping cart">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M3 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 8H6"/>
        <circle cx="10" cy="21" r="1"/>
        <circle cx="19" cy="21" r="1"/>
      </svg>
      <span class="cart-badge">0</span>
    </a>
  </div>
</header>
