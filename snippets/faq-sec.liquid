{{ 'faq-sec.css' | asset_url | stylesheet_tag }}

{%- assign faqs = shop.metaobjects.faq.values -%}

{%- if faqs.size > 0 -%}
  <section class="coffee-faq">
    <div class="faq-header">
      {%- if section_settings.heading != blank -%}
        <h2>{{ section_settings.heading }}</h2>
      {%- endif -%}

      {%- if section_settings.subtext != blank -%}
        <p>{{ section_settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="faq-list">
      {%- for faq in faqs -%}
        <details class="faq-item">
          <summary class="faq-question">
            <span>{{ faq.question | escape }}</span>
            <span class="faq-icon">+</span>
          </summary>

          <div class="faq-answer">
            <p>{{ faq.answer | escape }}</p>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}
