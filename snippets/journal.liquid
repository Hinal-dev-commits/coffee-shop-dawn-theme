{{ 'journal.css' | asset_url | stylesheet_tag }}

<section class="brewing-guides">
  <div class="guides-header">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="guides-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2>
          {{ section.settings.heading }}
          {%- if section.settings.heading_accent != blank %}
            <em>{{ section.settings.heading_accent }}</em>
          {%- endif -%}
        </h2>
      {%- endif -%}
    </div>

    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link_url | default: '#' }}" class="guides-link">
        {{ section.settings.link_label }}
        <span>→</span>
      </a>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="guides-grid">
      {%- for block in section.blocks -%}
        {%- assign image_alt = block.settings.image.alt | default: block.settings.title -%}

        <article class="guide-card" {{ block.shopify_attributes }}>
          <div class="guide-image">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '450, 600, 900',
                  sizes: '(min-width: 900px) 30vw, 90vw',
                  alt: image_alt
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          <div class="guide-content">
            {%- if block.settings.category != blank -%}
              <p class="guide-category">{{ block.settings.category }}</p>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3>{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.excerpt != blank -%}
              <p class="guide-excerpt">{{ block.settings.excerpt }}</p>
            {%- endif -%}

            {%- if block.settings.link_label != blank -%}
              <a href="{{ block.settings.link | default: '#' }}" class="guide-read">
                {{ block.settings.link_label }}
                <span>↗</span>
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>
